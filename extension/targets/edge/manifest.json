{
  "manifest_version": 3,
  "name": "MobX FormKit DevTools",
  "version": "1.0.0",
  "description": "Inspect MobX FormKit forms from the browser devtools panel",
  "devtools_page": "devtools_page.html",
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content-isolated.js"],
      "run_at": "document_start"
    }
  ]
}